#!/bin/sh
# Rockury pre-commit 게이트 (AGENTS.md 테스트 의무 강제) — 통과 못 하면 커밋 차단.
# 우회가 필요하면 `git commit --no-verify` (권장하지 않음, 사용자 판단).
set -e
echo "[pre-commit] typecheck · test · build (통과해야 커밋)"
npm run typecheck
npm test
npm run build >/dev/null

# ── e2e(앱 구동 스모크) — **기본은 안 돈다. 사용자가 지시할 때만 돈다.**
#    2026-07-30 사용자 지시: "내가 따로 명시적으로 e2e 테스트를 지시하기 전까지는 이제 하지마."
#    커밋마다 자동으로 도는 게 진절머리 난다는 지적이 반복돼 자동 실행을 뗐다
#    (그전 규칙: src/·e2e/ 를 건드리면 훅이 전체 한 바퀴를 돌렸다).
#    ⚠ e2e 자산 자체는 계속 쌓는다 — 새 앱 흐름은 `e2e/suites/` 에 스위트로 더한다(AGENTS.md 테스트 의무).
#       "안 돌린다"는 실행 시점 이야기이고, "안 만든다"가 아니다.
#    돌려야 할 때(사용자 지시가 있을 때):
#      RUN_E2E=1 git commit ...                            전체 한 바퀴
#      RUN_E2E=--only=07-console-schema git commit ...      그 스위트만
#      E2E_ARGS=--no-db 를 덧붙이면 test-db 스위트는 건너뛴다(그 스위트는 "미검증"으로 남는다)
if [ -z "$RUN_E2E" ]; then
  echo "[pre-commit] e2e 생략(기본 — 사용자 지시 시에만). 돌리려면 RUN_E2E=1 git commit ..."
else
  case "$RUN_E2E" in
    --only=*) E2E_SCOPE="$RUN_E2E" ;;
    *) E2E_SCOPE="--all" ;;
  esac
  echo "[pre-commit] e2e $E2E_SCOPE (test-db 전제 — 없으면 \`npm run db:up\`)"
  # shellcheck disable=SC2086
  npm run e2e -- $E2E_SCOPE ${E2E_ARGS:+$E2E_ARGS}
fi
echo "[pre-commit] ✔ 통과"
