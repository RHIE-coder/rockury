{
  "enabledPlugins": {
    "steward@steward": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "EndConversation",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.harness/steward/project/hooks/no-end-conversation.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.harness/steward/project/hooks/question-not-order.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
